---
const steps = [
  {
    num: '01',
    title: 'Contás el síntoma',
    desc: 'Describís qué pasa: vendo mucho pero no sé si gano, la caja no cierra, el stock no coincide.',
  },
  {
    num: '02',
    title: 'Subís la evidencia',
    desc: 'Mandás los archivos que tenés: ventas, costos, extractos, stock, facturas, lo que sea disponible.',
  },
  {
    num: '03',
    title: 'PymIA estructura los datos',
    desc: 'El laboratorio lee los archivos, detecta columnas, fechas e importes, y clasifica qué sirve para qué análisis.',
  },
  {
    num: '04',
    title: 'Se ejecuta el análisis',
    desc: 'Se cruzan ventas con costos, movimientos de caja con ventas facturadas, stock registrado con compras.',
  },
  {
    num: '05',
    title: 'Recibís hallazgos claros',
    desc: 'Un reporte con lo que se encontró, lo que falta para confirmar y el próximo paso concreto recomendado.',
  },
  {
    num: '06',
    title: 'Seguís la conversación',
    desc: 'Por WhatsApp o Telegram: pedís más análisis, subís archivos adicionales, recibís actualizaciones del estado operativo.',
  },
];
---

<section class="section" id="como-funciona">
  <div class="container">
    <div class="section-header centered">
      <span class="eyebrow">El proceso del laboratorio</span>
      <h2 class="h2">Del síntoma al hallazgo,<br />con evidencia de por medio.</h2>
    </div>

    <div class="steps">
      {steps.map((s, i) => (
        <div class="step">
          <div class="step-left">
            <div class="step-num">{s.num}</div>
            {i < steps.length - 1 && <div class="step-line"></div>}
          </div>
          <div class={`step-card card ${i % 2 === 1 ? 'alt' : ''}`}>
            <h3 class="step-title">{s.title}</h3>
            <p class="muted step-desc">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.steps {
  display: flex;
  flex-direction: column;
  gap: 0;
  max-width: 780px;
  margin: 0 auto;
}
.step {
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: 20px;
  align-items: start;
}
.step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}
.step-num {
  font-family: var(--font-mono);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--green);
  background: var(--green-soft);
  border: 1px solid rgba(0,230,118,.25);
  width: 56px;
  height: 56px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: -.02em;
}
.step-line {
  width: 2px;
  flex: 1;
  min-height: 40px;
  background: linear-gradient(180deg, rgba(0,230,118,.3), rgba(0,230,118,.05));
  margin: 6px 0;
}
.step-card {
  padding: 24px 28px;
  margin-bottom: 16px;
  transition: border-color .2s;
}
.step-card:hover {
  border-color: rgba(0,230,118,.22);
}
.step-card.alt {
  background: var(--panel-2);
}
.step-title {
  font-family: var(--font-display);
  font-size: 1.3rem;
  letter-spacing: -.025em;
  margin-bottom: 8px;
  color: var(--text);
}
.step-desc {
  font-size: .92rem;
  line-height: 1.7;
}

@media (max-width: 620px) {
  .step { grid-template-columns: 52px 1fr; gap: 14px; }
  .step-num { width: 44px; height: 44px; font-size: 1.1rem; }
  .step-card { padding: 18px 20px; }
}
</style>
